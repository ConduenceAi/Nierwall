# ---- Nierwall brain ----
# Local API for the Mac app, Snap and signing page (only listens on 127.0.0.1)
GUARDIAN_PORT=7420
# Optional shared secret for the local API (x-guardian-token header). Leave empty to get a fresh one on each
# start; the Mac app reads it from ~/Library/Application Support/Guardian/brain.json.
GUARDIAN_TOKEN=

# ---- NEAR AI Cloud (assistant model, runs in TEEs) ----
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# Stronger TEE model for planning questions (rebalancing, trades). Everyday chat uses NEAR_AI_MODEL.
NEAR_AI_PLANNER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# ---- Memory service (Graphiti) ----
# Needs no key of its own: facts are pulled out by the NEAR AI model above, through the brain, and search uses an
# embedding model that runs on the Mac.
MEMORY_URL=http://127.0.0.1:7421

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# How much detail alerts carry: generic | actionable | detailed
TELEGRAM_DETAIL=actionable

# ---- NEAR Intents (1Click) ----
# Optional API token. Quotes work without it.
ONECLICK_JWT=

# ---- CoinGecko (finding coins by name) ----
# Prices come from DefiLlama, which is free and needs no key. CoinGecko only finds coins by name and fills in the
# few prices DefiLlama doesn't have. Optional free CoinGecko key; raises the rate limit. Works without one.
COINGECKO_API_KEY=

# ---- Chains ----
NEAR_RPC_URL=https://free.rpc.fastnear.com


# ---- Simulated price drops ----
# Set to 1 to allow scenario price shocks (always labeled SIMULATED in alerts)
SCENARIO_MODE=1
