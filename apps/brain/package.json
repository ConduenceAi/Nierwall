{
  "name": "@guardian/brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nierwall's always-on agent: protocol readers, watch engine, planner, API, Telegram, NEAR AI agent",
  "scripts": {
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "simulate": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/cli/simulate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@hono/node-ws": "^1.3.1",
    "@nearai/inference-sdk": "0.3.0",
    "@rhea-finance/cross-chain-sdk": "0.1.22",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.18",
    "viem": "^2.57.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
