{
  "name": "@guardian/sign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local signing page: MetaMask (EIP-6963) for Base, NEAR Connect for NEAR. Nierwall never holds keys.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=dist/sign.js && cp public/index.html dist/index.html",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
